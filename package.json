{
  "name": "pre-sign-guard",
  "version": "0.1.0",
  "description": "A checker and agent skill that decodes EVM signing payloads before a key signs them: refuses unseen hashes, blocks EIP-7702 delegations, and explains everything else in plain words.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "guard": "./bin/guard"
  },
  "scripts": {
    "guard": "tsx src/cli.ts",
    "demo": "bash demo/run.sh",
    "test": "vitest run",
    "evals": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "build:playground": "esbuild playground/src/main.ts --bundle --format=iife --global-name=PreSignGuard --outfile=playground/bundle.js --target=es2020",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
