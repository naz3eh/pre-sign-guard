{
  "name": "pre-sign-guard",
  "version": "0.1.0",
  "description": "A checker and agent skill that decodes EVM signing payloads before a key signs them: refuses unseen hashes, blocks EIP-7702 delegations, and explains everything else in plain words.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "guard": "./bin/guard"
  },
  "scripts": {
    "guard": "tsx src/cli.ts",
    "demo": "bash demo/run.sh",
    "test": "vitest run",
    "evals": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/app/tsconfig.json",
    "build:playground": "rm -rf playground/assets playground/index.html && vite build playground/app",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
