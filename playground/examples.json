  {
    "id": "binance14-authorization",
    "label": "Binance 14 — real EIP-7702 authorization",
    "blurb": "The actual authorization bytes signed by the Binance 14 hot wallet — entry #15 of carrier tx 0xad99264d5532ae0dd04b2004eebda05f25657e70dacb764f7ac8d4ccd051298b (Ethereum block 26300753, Oct 29 2026). Delegates the account to 0x63e8…6fAe. Real chain data, verified on-chain.",
    "request": {
      "hash": "0xac384c3e6b0b119b06b4f409343faffa32a7410c91e9f049684e59513d2674ac",
      "preimage": "0x05db019463e842b054bd624a465454d533c33f573e9c6fae8401209df9"
    },
    "expect": { "verdict": "BLOCK", "kind": "eip7702-authorization" },
    "sources": [
